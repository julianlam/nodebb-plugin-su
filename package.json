{
  "name": "nodebb-plugin-su",
  "version": "1.0.0",
  "description": "Switch the current admin session to another user account",
  "main": "library.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/nodebb/nodebb-plugin-su"
  },
  "scripts": {
    "lint": "eslint ."
  },
  "keywords": [
    "nodebb",
    "plugin",
    "su",
    "shell"
  ],
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "git add"
    ]
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/nodebb/nodebb-plugin-su/issues"
  },
  "readmeFilename": "README.md",
  "nbbpm": {
    "compatibility": "^4.14.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-angular": "21.2.4",
    "eslint": "10.13.0",
    "eslint-config-nodebb": "2.0.3",
    "husky": "9.1.7",
    "lint-staged": "17.6.0"
  }
}
